{
  "name": "pdf-case-review",
  "displayName": "%displayName%",
  "version": "0.1.1",
  "description": "%description%",
  "publisher": "realslimslaney",
  "author": "Brennen Slaney",
  "license": "Apache-2.0",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realslimslaney/pdf-case-review.git"
  },
  "bugs": {
    "url": "https://github.com/realslimslaney/pdf-case-review/issues"
  },
  "homepage": "https://github.com/realslimslaney/pdf-case-review#readme",
  "categories": [
    "Visualization",
    "Education",
    "Other"
  ],
  "keywords": [
    "pdf",
    "highlight",
    "annotate",
    "notes",
    "case study",
    "report",
    "reading"
  ],
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "AI summary providers and the report output folder setting are disabled in untrusted workspaces.",
      "restrictedConfigurations": [
        "pdfCaseReview.report.outputFolder",
        "pdfCaseReview.ai.provider",
        "pdfCaseReview.ai.requiredAccount",
        "pdfCaseReview.ai.accounts"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Highlights are saved beside the PDF; virtual file systems that cannot write sidecars are read-only."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfCaseReview.pdf",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.review.json",
        "url": "./schemas/review.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pdfCaseReview",
          "title": "%viewsContainer.title%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "pdfCaseReview": [
        {
          "id": "pdfCaseReview.highlights",
          "name": "%view.highlights%",
          "icon": "media/activity.svg",
          "contextualTitle": "%viewsContainer.title%"
        },
        {
          "id": "pdfCaseReview.noteEditor",
          "type": "webview",
          "name": "%view.noteEditor%",
          "icon": "media/activity.svg",
          "contextualTitle": "%viewsContainer.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pdfCaseReview.highlights",
        "contents": "%viewsWelcome.highlights%",
        "when": "!pdfCaseReview.hasActiveDocument"
      }
    ],
    "commands": [
      {
        "command": "pdfCaseReview.goToHighlight",
        "title": "%command.goToHighlight%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.setCategory",
        "title": "%command.setCategory%",
        "category": "%commandCategory%",
        "icon": "$(symbol-color)"
      },
      {
        "command": "pdfCaseReview.deleteHighlight",
        "title": "%command.deleteHighlight%",
        "category": "%commandCategory%",
        "icon": "$(trash)"
      },
      {
        "command": "pdfCaseReview.copyQuote",
        "title": "%command.copyQuote%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.revealSidecar",
        "title": "%command.revealSidecar%",
        "category": "%commandCategory%",
        "icon": "$(json)"
      },
      {
        "command": "pdfCaseReview.groupByCategory",
        "title": "%command.groupByCategory%",
        "category": "%commandCategory%",
        "icon": "$(symbol-class)"
      },
      {
        "command": "pdfCaseReview.groupByPage",
        "title": "%command.groupByPage%",
        "category": "%commandCategory%",
        "icon": "$(book)"
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "title": "%command.highlightWithCategory%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.applyCategoryPreset",
        "title": "%command.applyCategoryPreset%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.syncCategoriesFromSettings",
        "title": "%command.syncCategoriesFromSettings%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.addPageNote",
        "title": "%command.addPageNote%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.addDocumentNote",
        "title": "%command.addDocumentNote%",
        "category": "%commandCategory%",
        "icon": "$(note)"
      },
      {
        "command": "pdfCaseReview.deleteNote",
        "title": "%command.deleteNote%",
        "category": "%commandCategory%",
        "icon": "$(trash)"
      },
      {
        "command": "pdfCaseReview.editNote",
        "title": "%command.editNote%",
        "category": "%commandCategory%",
        "icon": "$(note)"
      },
      {
        "command": "pdfCaseReview.generateReport",
        "title": "%command.generateReport%",
        "category": "%commandCategory%",
        "icon": "$(output)"
      },
      {
        "command": "pdfCaseReview.generateReportAs",
        "title": "%command.generateReportAs%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.exportAnnotatedPdf",
        "title": "%command.exportAnnotatedPdf%",
        "category": "%commandCategory%",
        "icon": "$(export)"
      },
      {
        "command": "pdfCaseReview.ai.copySummaryPrompt",
        "title": "%command.ai.copySummaryPrompt%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.ai.pasteSummary",
        "title": "%command.ai.pasteSummary%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.ai.reviewConsent",
        "title": "%command.ai.reviewConsent%",
        "category": "%commandCategory%"
      },
      {
        "command": "pdfCaseReview.summarizeWithAi",
        "title": "%command.summarizeWithAi%",
        "category": "%commandCategory%",
        "icon": "$(sparkle)"
      },
      {
        "command": "pdfCaseReview.ai.chooseProvider",
        "title": "%command.ai.chooseProvider%",
        "category": "%commandCategory%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pdfCaseReview.goToHighlight",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.setCategory",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.deleteHighlight",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.copyQuote",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.revealSidecar",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.groupByCategory",
          "when": "pdfCaseReview.groupBy == page"
        },
        {
          "command": "pdfCaseReview.groupByPage",
          "when": "pdfCaseReview.groupBy == category"
        },
        {
          "command": "pdfCaseReview.highlightWithCategory",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.syncCategoriesFromSettings",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.addPageNote",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.addDocumentNote",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.deleteNote",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.editNote",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.generateReport",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.generateReportAs",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.exportAnnotatedPdf",
          "when": "pdfCaseReview.hasActiveDocument"
        },
        {
          "command": "pdfCaseReview.ai.copySummaryPrompt",
          "when": "pdfCaseReview.hasActiveDocument && isWorkspaceTrusted"
        },
        {
          "command": "pdfCaseReview.ai.pasteSummary",
          "when": "pdfCaseReview.hasActiveDocument && isWorkspaceTrusted"
        },
        {
          "command": "pdfCaseReview.ai.reviewConsent",
          "when": "pdfCaseReview.hasActiveDocument && isWorkspaceTrusted"
        },
        {
          "command": "pdfCaseReview.summarizeWithAi",
          "when": "pdfCaseReview.hasActiveDocument && isWorkspaceTrusted"
        }
      ],
      "editor/title": [
        {
          "command": "pdfCaseReview.generateReport",
          "when": "activeCustomEditorId == pdfCaseReview.pdf",
          "group": "navigation@1"
        },
        {
          "command": "pdfCaseReview.summarizeWithAi",
          "when": "activeCustomEditorId == pdfCaseReview.pdf && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "pdfCaseReview.addDocumentNote",
          "when": "activeCustomEditorId == pdfCaseReview.pdf",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "pdfCaseReview.groupByPage",
          "when": "view == pdfCaseReview.highlights && pdfCaseReview.groupBy == category",
          "group": "navigation@1"
        },
        {
          "command": "pdfCaseReview.groupByCategory",
          "when": "view == pdfCaseReview.highlights && pdfCaseReview.groupBy == page",
          "group": "navigation@1"
        },
        {
          "command": "pdfCaseReview.revealSidecar",
          "when": "view == pdfCaseReview.highlights && pdfCaseReview.hasActiveDocument",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "pdfCaseReview.editNote",
          "when": "view == pdfCaseReview.highlights && (viewItem == highlight || viewItem == pageNote || viewItem == documentNote)",
          "group": "1_edit@0"
        },
        {
          "command": "pdfCaseReview.setCategory",
          "when": "view == pdfCaseReview.highlights && viewItem == highlight",
          "group": "1_edit@1"
        },
        {
          "command": "pdfCaseReview.copyQuote",
          "when": "view == pdfCaseReview.highlights && viewItem == highlight",
          "group": "1_edit@2"
        },
        {
          "command": "pdfCaseReview.deleteHighlight",
          "when": "view == pdfCaseReview.highlights && viewItem == highlight",
          "group": "2_danger@1"
        },
        {
          "command": "pdfCaseReview.deleteHighlight",
          "when": "view == pdfCaseReview.highlights && viewItem == highlight",
          "group": "inline"
        },
        {
          "command": "pdfCaseReview.deleteNote",
          "when": "view == pdfCaseReview.highlights && (viewItem == pageNote || viewItem == documentNote)",
          "group": "2_danger@1"
        },
        {
          "command": "pdfCaseReview.deleteNote",
          "when": "view == pdfCaseReview.highlights && (viewItem == pageNote || viewItem == documentNote)",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 1
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 2
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 3
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 4
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 5
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 6
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+7",
        "mac": "cmd+alt+7",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 7
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+8",
        "mac": "cmd+alt+8",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 8
        }
      },
      {
        "command": "pdfCaseReview.highlightWithCategory",
        "key": "ctrl+alt+9",
        "mac": "cmd+alt+9",
        "when": "activeCustomEditorId == pdfCaseReview.pdf",
        "args": {
          "index": 9
        }
      },
      {
        "command": "pdfCaseReview.addDocumentNote",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "activeCustomEditorId == pdfCaseReview.pdf"
      },
      {
        "command": "pdfCaseReview.editNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "activeCustomEditorId == pdfCaseReview.pdf"
      },
      {
        "command": "pdfCaseReview.generateReport",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "pdfCaseReview.hasActiveDocument"
      },
      {
        "command": "pdfCaseReview.goToHighlight",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "pdfCaseReview.hasActiveDocument"
      },
      {
        "command": "pdfCaseReview.highlights.focus",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "pdfCaseReview.hasActiveDocument"
      }
    ],
    "configuration": {
      "title": "PDF Case Review",
      "properties": {
        "pdfCaseReview.categories": {
          "type": "array",
          "scope": "resource",
          "markdownDescription": "Highlight categories. Each needs a unique `id`, a `name`, and a unique hex `color`; colors are how the viewer tells categories apart, so keep them distinct.",
          "default": [
            {
              "id": "fact",
              "name": "Fact",
              "color": "#FFFF98"
            },
            {
              "id": "financial",
              "name": "Financial",
              "color": "#53FFBC"
            },
            {
              "id": "strategic",
              "name": "Strategic implication",
              "color": "#80EBFF"
            },
            {
              "id": "concern",
              "name": "Concern",
              "color": "#FF4F5F"
            },
            {
              "id": "question",
              "name": "Question",
              "color": "#FFCBE6"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "color"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "pdfCaseReview.categoryPresets": {
          "type": "object",
          "scope": "window",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "color"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "markdownDescription": "Extra palettes for `PDF Case Review: Apply Category Preset`, keyed by name (`Business case`, `Academic paper` and `Contract` are built in). Each preset has the same shape as `#pdfCaseReview.categories#`."
        },
        "pdfCaseReview.sidecar.location": {
          "type": "string",
          "scope": "resource",
          "default": "beside",
          "enum": [
            "beside",
            "folder"
          ],
          "enumDescriptions": [
            "Next to the PDF, as <name>.pdf.review.json",
            "Under <workspace>/.pdf-case-review/<relative path>.review.json"
          ],
          "markdownDescription": "Where highlights and notes are stored. `folder` keeps them out of directories you do not control; a PDF outside the workspace always gets its file beside it."
        },
        "pdfCaseReview.pdf.embedOnSave": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "markdownDescription": "On save, rewrite the PDF so your highlights become real annotations other readers can see. Only applies to unencrypted PDFs; publisher-protected files are never modified. Turn off to keep PDFs byte-identical (for example in a git repository) and store highlights in the sidecar only."
        },
        "pdfCaseReview.highlights.groupBy": {
          "type": "string",
          "scope": "window",
          "default": "category",
          "enum": [
            "category",
            "page"
          ],
          "enumDescriptions": [
            "One group per category, in palette order",
            "One group per page, in reading order"
          ],
          "description": "How the Highlights view groups highlights."
        },
        "pdfCaseReview.report.defaultFormat": {
          "type": "string",
          "scope": "resource",
          "default": "ask",
          "enum": [
            "ask",
            "markdown",
            "docx",
            "pdf"
          ],
          "enumDescriptions": [
            "Ask with a picker every time",
            "Markdown (.md)",
            "Word (.docx)",
            "PDF (.pdf)"
          ],
          "description": "Format used by Generate Report (Ctrl+Alt+R)."
        },
        "pdfCaseReview.report.organization": {
          "type": "string",
          "scope": "resource",
          "default": "both",
          "enum": [
            "category",
            "page",
            "both"
          ],
          "enumDescriptions": [
            "Sections per category",
            "Sections per page, in reading order",
            "Sections per category, plus a per-page appendix"
          ],
          "description": "How the report body is organized."
        },
        "pdfCaseReview.report.outputFolder": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Folder for generated reports. Empty writes next to the PDF; a relative path is resolved against the workspace folder. Ignored in untrusted workspaces."
        },
        "pdfCaseReview.report.quoteMaxChars": {
          "type": "number",
          "scope": "resource",
          "default": 300,
          "minimum": 0,
          "description": "Longest quoted passage in the report, truncated at a word boundary. 0 means unlimited."
        },
        "pdfCaseReview.report.author": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Author shown in the report's title block. Empty omits the line."
        },
        "pdfCaseReview.report.includeEmptyCategories": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "Show categories with no highlights in the report's summary table and body."
        },
        "pdfCaseReview.report.usePageLabels": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "markdownDescription": "Cite the PDF's own page labels when they differ from page numbers, as `p. iv [4]`."
        },
        "pdfCaseReview.report.overwrite": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "markdownDescription": "Overwrite an existing `<name>.review.<ext>` report. Off writes a numbered copy instead."
        },
        "pdfCaseReview.ai.provider": {
          "type": "string",
          "scope": "resource",
          "default": "off",
          "enum": [
            "off",
            "claude-cli",
            "codex-cli"
          ],
          "enumDescriptions": [
            "No AI. The manual Copy Summary Prompt / Paste AI Summary commands still work.",
            "Claude Code CLI (spawns `claude`; desktop only)",
            "Codex CLI (spawns `codex`; desktop only)"
          ],
          "markdownDescription": "AI provider for the optional executive summary. Off by default: nothing leaves your machine unless you enable a provider, and only your highlights and notes are ever sent, never the PDF. You are responsible for using AI on appropriate content; the developers of this extension are not liable for misuse."
        },
        "pdfCaseReview.ai.model": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Model passed to the provider CLI (`--model`). Empty uses the CLI's default."
        },
        "pdfCaseReview.ai.includeInReport": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Include the cached AI summary as a labeled section of generated reports."
        },
        "pdfCaseReview.ai.maxWords": {
          "type": "number",
          "scope": "resource",
          "default": 250,
          "minimum": 1,
          "description": "Word budget for the AI executive summary."
        },
        "pdfCaseReview.ai.requiredAccount": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "type": "object",
                "properties": {
                  "protected": {
                    "type": "boolean"
                  },
                  "authorizationLineMatches": {
                    "type": "string"
                  },
                  "pathGlob": {
                    "type": "string"
                  }
                }
              },
              "email": {
                "type": "string"
              },
              "use": {
                "type": "string"
              }
            }
          },
          "markdownDescription": "Rules refusing the AI step under the wrong login. The first rule whose `when` conditions match applies; `email` names the account that must be signed in (no override), and `use` names an entry of `#pdfCaseReview.ai.accounts#` to run under. Example: `[{ \"when\": { \"protected\": true }, \"email\": \"you@school.edu\" }]`."
        },
        "pdfCaseReview.ai.accounts": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "provider",
              "configDir"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "claude-cli",
                  "codex-cli"
                ]
              },
              "configDir": {
                "type": "string"
              }
            }
          },
          "markdownDescription": "Separate CLI login directories for people with more than one account, e.g. `[{ \"id\": \"school\", \"provider\": \"claude-cli\", \"configDir\": \"~/.claude-school\" }]`. A `#pdfCaseReview.ai.requiredAccount#` rule selects one with `use`; the extension sets `CLAUDE_CONFIG_DIR` or `CODEX_HOME` on the spawned CLI itself. The account's `provider` must match `#pdfCaseReview.ai.provider#`."
        },
        "pdfCaseReview.ai.requireVerifiedAccountForProtected": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "markdownDescription": "Refuse to run AI providers on publisher-protected documents when the logged-in account cannot be verified from the CLI's saved login. The manual Copy Summary Prompt asks for an extra acknowledgment instead."
        },
        "pdfCaseReview.viewer.defaultZoom": {
          "type": "string",
          "scope": "resource",
          "default": "auto",
          "enum": [
            "auto",
            "page-actual",
            "page-fit",
            "page-width",
            "50",
            "75",
            "100",
            "125",
            "150",
            "200"
          ],
          "description": "Zoom level when a PDF opens."
        },
        "pdfCaseReview.viewer.maxCanvasPixels": {
          "type": "number",
          "scope": "resource",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Maximum canvas area, in pixels, a page may render at; larger pages render at reduced resolution. `0` keeps the PDF.js default. Lower it (for example to `4194304`) to cut memory use on very large documents. Takes effect when the PDF is reopened."
        },
        "pdfCaseReview.viewer.maxImageSize": {
          "type": "number",
          "scope": "resource",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Maximum decoded image size, in pixels (width times height); larger images are not rendered. `0` keeps the PDF.js default (no limit). Lower it to cut memory use on image-heavy scans. Takes effect when the PDF is reopened."
        },
        "pdfCaseReview.viewer.retainContextWhenHidden": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "markdownDescription": "Keep the viewer alive while its tab is hidden, so switching back is instant and viewer state survives. Turn off to free the renderer's memory for hidden tabs; the viewer then reloads (keeping your highlights) when the tab is shown again. Takes effect after reloading the window."
        },
        "pdfCaseReview.viewer.sidebarOnLoad": {
          "type": "number",
          "scope": "resource",
          "default": 0,
          "enum": [
            -1,
            0,
            1,
            2,
            3,
            4
          ],
          "enumDescriptions": [
            "Restore previous state",
            "None",
            "Thumbnails",
            "Outline",
            "Attachments",
            "Layers"
          ],
          "description": "PDF.js sidebar panel to show when a PDF opens."
        }
      }
    }
  },
